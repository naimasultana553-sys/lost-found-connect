# SQLite database location (relative to prisma/ folder)
DATABASE_URL="file:./dev.db"

# Used by iron-session to encrypt session cookies. Must be at least 32 chars.
# Generate one with: openssl rand -base64 32  (or any random 32+ char string)
SESSION_SECRET="change-me-to-a-long-random-secret-32-chars-min"

# --- Vercel deployment (optional, only needed when deploying to Vercel) ---
# The serverless filesystem is read-only, so the DB is created in /tmp:
# DATABASE_URL="file:/tmp/findback.db"
#
# Vercel Blob token so uploaded photos persist (create a store with:
#   vercel blob create-store findback )
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
