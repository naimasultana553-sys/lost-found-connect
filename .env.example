# MongoDB Atlas connection string (free M0 cluster). Get one at https://www.mongodb.com/atlas
# Format: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DBNAME?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/findback?retryWrites=true&w=majority"

# Used by iron-session to encrypt session cookies. Must be at least 32 chars.
# Generate one with: openssl rand -base64 32  (or any random 32+ char string)
SESSION_SECRET="change-me-to-a-long-random-secret-32-chars-min"

# --- Vercel deployment ---
# Set the same DATABASE_URL (and a real SESSION_SECRET) as environment
# variables on Vercel. The build script runs `prisma db push` automatically,
# so collections are created in Atlas on every deploy.
