# SQLite database location (relative to prisma/ folder)
DATABASE_URL="file:./dev.db"

# Used by iron-session to encrypt session cookies. Must be at least 32 chars.
# Generate one with: openssl rand -base64 32  (or any random 32+ char string)
SESSION_SECRET="change-me-to-a-long-random-secret-32-chars-min"

# --- Vercel deployment (only needed when deploying to Vercel) ---
# The serverless filesystem is read-only, so the database lives in /tmp.
# The app creates the tables automatically on first use.
# DATABASE_URL="file:/tmp/findback.db"
