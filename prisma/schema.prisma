// FindBack — Prisma schema (MongoDB)
//
// Keep models modular so V2/V3 features (chat, ratings, admin, advanced
// matching) can be added without restructuring. `imageHash` stores a
// perceptual hash (dHash) computed at report time; it is the primary
// image-matching signal and is not part of the public data model spec.
//
// Note: Prisma's MongoDB connector has no relation support, so references
// between collections (userId, lostItemId, foundItemId, matchId) are plain
// ObjectId strings joined manually in the query layer (see src/lib/queries.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Image {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  data      Bytes
  mimeType  String   @default("image/jpeg")
  createdAt DateTime @default(now())

  @@map("images")
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("users")
}

model LostItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  imageUrl    String
  imageHash   String?
  itemName    String
  category    String
  description String?
  location    String
  dateLost    DateTime
  status      String   @default("SEARCHING")
  createdAt   DateTime @default(now())

  @@map("lost_items")
}

model FoundItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  imageUrl    String
  imageHash   String?
  itemName    String
  category    String
  description String?
  location    String
  dateFound   DateTime
  status      String   @default("AVAILABLE")
  createdAt   DateTime @default(now())

  @@map("found_items")
}

// A "possible match" — never a confirmed match. The system only suggests.
// status: POSSIBLE (suggested) | OWNER_INTERESTED (claim pending) | CONNECTED (accepted)
model Match {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  lostItemId      String   @db.ObjectId
  foundItemId     String   @db.ObjectId
  similarityScore Int // 0-99 combined score (image + text + location + date)
  imageScore      Int? // 0-100 AI (Gemini) image similarity at match time; null = dHash fallback
  status          String   @default("POSSIBLE") // POSSIBLE | OWNER_INTERESTED | CONNECTED
  createdAt       DateTime @default(now())

  @@unique([lostItemId, foundItemId])
  @@map("matches")
}

// An ownership claim from the lost-item owner to the finder. The finder must
// explicitly accept before the two are connected. Never auto-confirms.
// status: PENDING | ACCEPTED | REJECTED
model Claim {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  matchId     String   @db.ObjectId
  ownerUserId String   @db.ObjectId
  detail      String // identifying detail the owner provides to prove ownership
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@map("claims")
}

// A private conversation created when a claim is accepted. Only the two
// participants (lost-item reporter + found-item reporter) may access it.
model Conversation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  matchId   String   @unique @db.ObjectId
  createdAt DateTime @default(now())

  @@map("conversations")
}

model Message {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String   @db.ObjectId
  senderId       String   @db.ObjectId
  text           String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@map("messages")
}

// type: MATCH (possible match) | CLAIM (new claim) | CLAIM_ACCEPTED |
//        CLAIM_REJECTED | MESSAGE (new chat message) | RETURNED
model Notification {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  matchId        String?  @db.ObjectId
  conversationId String?  @db.ObjectId
  type           String   @default("MATCH")
  title          String
  message        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@map("notifications")
}
