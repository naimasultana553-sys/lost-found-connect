// FindBack — Prisma schema (SQLite)
//
// Keep models modular so V2/V3 features (chat, ratings, admin, advanced
// matching) can be added without restructuring. `imageHash` stores a
// perceptual hash (dHash) computed at report time; it is the primary
// image-matching signal and is not part of the public data model spec.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())

  lostItems     LostItem[]
  foundItems    FoundItem[]
  notifications Notification[]

  @@map("users")
}

model LostItem {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  imageUrl    String
  imageHash   String?
  itemName    String
  category    String
  description String?
  location    String
  dateLost    DateTime
  status      String     @default("SEARCHING")
  createdAt   DateTime   @default(now())

  matches     Match[]

  @@map("lost_items")
}

model FoundItem {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  imageUrl    String
  imageHash   String?
  itemName    String
  category    String
  description String?
  location    String
  dateFound   DateTime
  status      String     @default("AVAILABLE")
  createdAt   DateTime   @default(now())

  matches     Match[]

  @@map("found_items")
}

// A "possible match" — never a confirmed match. The system only suggests.
model Match {
  id              String       @id @default(cuid())
  lostItemId      String
  foundItemId     String
  lostItem        LostItem     @relation(fields: [lostItemId], references: [id], onDelete: Cascade)
  foundItem       FoundItem    @relation(fields: [foundItemId], references: [id], onDelete: Cascade)
  similarityScore Int          // 0-99 combined score (image + text + location + date)
  status          String       @default("POSSIBLE") // POSSIBLE | OWNER_INTERESTED
  createdAt       DateTime     @default(now())

  notifications   Notification[]

  @@unique([lostItemId, foundItemId])
  @@map("matches")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  matchId   String?
  match     Match?   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}
